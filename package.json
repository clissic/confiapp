{
  "name": "confiapp",
  "version": "0.0.0",
  "private": true,
  "description": "ConfiApp — plataforma de escrow físico para transacciones seguras",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @confiapp/web test:e2e",
    "demo:tunnel": "node ./scripts/demo-tunnel.mjs",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@confiapp/config": "workspace:*",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser@<1.20.9": "^1.20.9",
      "proxy-addr@<2.0.8": "^2.0.8",
      "qs@<6.16.1": "^6.16.1",
      "engine.io@<6.6.10": "^6.6.10",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "follow-redirects@<1.16.2": "^1.16.2",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "source-map-js@<1.2.2": "^1.2.2",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss-selector-parser@<6.1.5": "^6.1.5"
    }
  }
}
