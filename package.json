{
  "name": "confiapp",
  "version": "0.0.0",
  "private": true,
  "description": "ConfiApp — plataforma de escrow físico para transacciones seguras",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @confiapp/web test:e2e",
    "demo:tunnel": "node ./scripts/demo-tunnel.mjs",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@confiapp/config": "workspace:*",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
