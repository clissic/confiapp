{
  "$schema": "https://confiapp.local/design-system/tokens.schema.json",
  "meta": {
    "name": "ConfiApp Design System",
    "version": "1.0.0",
    "brand": "ConfiApp",
    "positioning": "Plataforma de confianza / escrow físico — no marketplace",
    "principles": [
      "Seguridad",
      "Confianza",
      "Profesionalismo",
      "Simplicidad",
      "Elegancia"
    ]
  },
  "color": {
    "brand": {
      "primary": {
        "50": "#E6EEF7",
        "100": "#C2D4E9",
        "200": "#9BB8D9",
        "300": "#739CC8",
        "400": "#4A7FB5",
        "500": "#245F96",
        "600": "#0F447A",
        "700": "#01285D",
        "800": "#011F49",
        "900": "#011533",
        "DEFAULT": "#01285D"
      },
      "secondary": {
        "50": "#EEF9F7",
        "100": "#D4F1EC",
        "200": "#A8E3D8",
        "300": "#7DD5C4",
        "400": "#55C5B5",
        "500": "#3AAE9D",
        "600": "#2C8A7C",
        "700": "#21685E",
        "800": "#174740",
        "900": "#0E2B27",
        "DEFAULT": "#55C5B5"
      }
    },
    "neutral": {
      "gray": {
        "50": "#F7F9FC",
        "100": "#EEF2F7",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A"
      },
      "white": "#FFFFFF",
      "black": "#0B1220"
    },
    "semantic": {
      "success": {
        "bg": "#E8F7F2",
        "border": "#9DD9C7",
        "fg": "#0F6B52",
        "solid": "#1B9E78"
      },
      "warning": {
        "bg": "#FFF7E8",
        "border": "#F5D08A",
        "fg": "#8A5A00",
        "solid": "#D97706"
      },
      "danger": {
        "bg": "#FDECEC",
        "border": "#F0B4B4",
        "fg": "#9B1C1C",
        "solid": "#DC2626"
      },
      "info": {
        "bg": "#E8F1FA",
        "border": "#A8C6E4",
        "fg": "#01285D",
        "solid": "#245F96"
      },
      "disabled": {
        "bg": "#EEF2F7",
        "border": "#E2E8F0",
        "fg": "#94A3B8",
        "solid": "#CBD5E1"
      }
    },
    "dark": {
      "surface": {
        "canvas": "#070F1C",
        "base": "#0B1626",
        "raised": "#122033",
        "overlay": "#1A2B42",
        "sunken": "#06101A"
      },
      "brand": {
        "primary": "#4A7FB5",
        "primaryStrong": "#9BB8D9",
        "secondary": "#55C5B5",
        "secondaryStrong": "#7DD5C4"
      },
      "text": {
        "primary": "#F7F9FC",
        "secondary": "#CBD5E1",
        "muted": "#94A3B8",
        "inverse": "#0F172A"
      },
      "border": {
        "subtle": "#1E293B",
        "default": "#334155",
        "strong": "#475569"
      },
      "semantic": {
        "success": {
          "bg": "#0E2B27",
          "border": "#21685E",
          "fg": "#A8E3D8",
          "solid": "#3AAE9D"
        },
        "warning": {
          "bg": "#2A1D08",
          "border": "#8A5A00",
          "fg": "#F5D08A",
          "solid": "#D97706"
        },
        "danger": {
          "bg": "#2A1010",
          "border": "#9B1C1C",
          "fg": "#F0B4B4",
          "solid": "#EF4444"
        },
        "info": {
          "bg": "#0F1F33",
          "border": "#245F96",
          "fg": "#C2D4E9",
          "solid": "#4A7FB5"
        },
        "disabled": {
          "bg": "#122033",
          "border": "#1E293B",
          "fg": "#64748B",
          "solid": "#334155"
        }
      }
    },
    "light": {
      "surface": {
        "canvas": "#F7F9FC",
        "base": "#FFFFFF",
        "raised": "#FFFFFF",
        "overlay": "#FFFFFF",
        "sunken": "#EEF2F7"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#334155",
        "muted": "#64748B",
        "inverse": "#FFFFFF",
        "onPrimary": "#FFFFFF",
        "onSecondary": "#01285D"
      },
      "border": {
        "subtle": "#EEF2F7",
        "default": "#E2E8F0",
        "strong": "#CBD5E1"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": ["Inter", "system-ui", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
      "mono": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "display": {
        "fontSize": "3rem",
        "lineHeight": "3.5rem",
        "fontWeight": 700,
        "letterSpacing": "-0.02em"
      },
      "h1": {
        "fontSize": "2.25rem",
        "lineHeight": "2.75rem",
        "fontWeight": 700,
        "letterSpacing": "-0.02em"
      },
      "h2": {
        "fontSize": "1.875rem",
        "lineHeight": "2.375rem",
        "fontWeight": 700,
        "letterSpacing": "-0.015em"
      },
      "h3": {
        "fontSize": "1.5rem",
        "lineHeight": "2rem",
        "fontWeight": 600,
        "letterSpacing": "-0.01em"
      },
      "h4": {
        "fontSize": "1.25rem",
        "lineHeight": "1.75rem",
        "fontWeight": 600,
        "letterSpacing": "-0.01em"
      },
      "bodyLarge": {
        "fontSize": "1.125rem",
        "lineHeight": "1.75rem",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "body": {
        "fontSize": "1rem",
        "lineHeight": "1.5rem",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "small": {
        "fontSize": "0.875rem",
        "lineHeight": "1.25rem",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "caption": {
        "fontSize": "0.75rem",
        "lineHeight": "1rem",
        "fontWeight": 500,
        "letterSpacing": "0.02em"
      },
      "button": {
        "fontSize": "0.875rem",
        "lineHeight": "1.25rem",
        "fontWeight": 600,
        "letterSpacing": "0.01em"
      }
    }
  },
  "spacing": {
    "unit": 8,
    "scale": {
      "0": "0px",
      "0.5": "4px",
      "1": "8px",
      "1.5": "12px",
      "2": "16px",
      "2.5": "20px",
      "3": "24px",
      "4": "32px",
      "5": "40px",
      "6": "48px",
      "7": "56px",
      "8": "64px",
      "9": "72px",
      "10": "80px",
      "12": "96px",
      "16": "128px",
      "20": "160px",
      "24": "192px"
    }
  },
  "radius": {
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "24px",
    "full": "9999px"
  },
  "shadow": {
    "0": "none",
    "1": "0 1px 2px rgba(1, 40, 93, 0.06)",
    "2": "0 2px 4px rgba(1, 40, 93, 0.08)",
    "3": "0 4px 12px rgba(1, 40, 93, 0.10)",
    "4": "0 8px 24px rgba(1, 40, 93, 0.12)",
    "5": "0 16px 40px rgba(1, 40, 93, 0.14)",
    "6": "0 24px 56px rgba(1, 40, 93, 0.18)"
  },
  "shadowDark": {
    "0": "none",
    "1": "0 1px 2px rgba(0, 0, 0, 0.35)",
    "2": "0 2px 6px rgba(0, 0, 0, 0.40)",
    "3": "0 4px 14px rgba(0, 0, 0, 0.45)",
    "4": "0 8px 28px rgba(0, 0, 0, 0.50)",
    "5": "0 16px 44px rgba(0, 0, 0, 0.55)",
    "6": "0 24px 64px rgba(0, 0, 0, 0.60)"
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "120ms",
      "base": "180ms",
      "slow": "250ms",
      "max": "250ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)"
    },
    "presets": {
      "hover": { "duration": "120ms", "properties": ["color", "background-color", "border-color", "box-shadow", "transform"] },
      "tap": { "duration": "80ms", "scale": 0.98 },
      "open": { "duration": "180ms", "easing": "enter" },
      "close": { "duration": "120ms", "easing": "exit" },
      "fade": { "duration": "180ms", "from": 0, "to": 1 },
      "slide": { "duration": "180ms", "distance": "8px" },
      "scale": { "duration": "180ms", "from": 0.96, "to": 1 }
    }
  },
  "breakpoint": {
    "xs": "0px",
    "sm": "576px",
    "md": "768px",
    "lg": "992px",
    "xl": "1200px",
    "xxl": "1400px"
  },
  "zIndex": {
    "base": 0,
    "dropdown": 1000,
    "sticky": 1020,
    "fixed": 1030,
    "modalBackdrop": 1040,
    "modal": 1050,
    "popover": 1060,
    "tooltip": 1070,
    "toast": 1080
  },
  "icon": {
    "library": "lucide-react",
    "defaultStyle": "outline",
    "strokeWidth": {
      "default": 1.75,
      "emphasis": 2,
      "soft": 1.5
    },
    "size": {
      "xs": 14,
      "sm": 16,
      "md": 20,
      "lg": 24,
      "xl": 32
    },
    "usage": {
      "outline": "Navegación, acciones secundarias, tablas, formularios",
      "filled": "Estados confirmados, badges, indicadores activos, CTA con ícono crítico"
    }
  },
  "focus": {
    "ringWidth": "2px",
    "ringOffset": "2px",
    "ringColorLight": "#55C5B5",
    "ringColorDark": "#7DD5C4"
  },
  "accessibility": {
    "standard": "WCAG 2.1 AA",
    "minContrastNormalText": 4.5,
    "minContrastLargeText": 3,
    "minContrastUi": 3,
    "reducedMotion": "Respect prefers-reduced-motion; set duration to 0 or opacity-only"
  }
}
