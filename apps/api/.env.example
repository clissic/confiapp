# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (Mongoose / MongoDB)
DATABASE_URL=mongodb://127.0.0.1:27017/confiapp?directConnection=true

# Auth / JWT (secrets >= 32 chars)
JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_REFRESH_EXPIRES_IN=7d

# Public URLs (email links)
APP_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000

# CORS (producción: orígenes del front. En desarrollo también se aceptan LAN/túneles)
CORS_ORIGIN=http://localhost:3001

# Cookies
COOKIE_SECURE=false

# Logging
LOG_LEVEL=debug

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Lockout (OWASP)
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Mercado Pago Uruguay (cuenta MLU / plataforma Checkout Pro). Vacío = MOCK local
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COUNTRY=UY
MERCADOPAGO_SITE_ID=MLU

# OAuth vendedores (Authorization Code + PKCE). Independiente del ACCESS_TOKEN de plataforma.
# En el panel MP: registrar exactamente MERCADOPAGO_OAUTH_REDIRECT_URI (sin params extra).
# Local: localhost solo si MP lo acepta; si no, túnel HTTPS estático con la misma URI.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3000/payments/mercadopago/oauth/callback
# 32 bytes en hex (64 chars). Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=

# Cobro al comprador: manual_prex (MVP transferencia Prex) | mercadopago (Checkout Pro / MOCK)
# Con manual_prex, el flujo MP queda en standby (código intacto).
PAYMENTS_CHECKOUT_MODE=manual_prex
PAYMENTS_PREX_ACCOUNT_NAME=Ignacio La Cava
PAYMENTS_PREX_ACCOUNT_NUMBER=1065233

# Monedas de la app: UYU (default) | USD
PAYMENTS_DEFAULT_CURRENCY=UYU

# Fees (basis points): 2000=20% plataforma, 8000=80% agente
PAYMENTS_PLATFORM_FEE_BPS=2000
PAYMENTS_AGENT_FEE_BPS=8000

# Escrow completo (producto + comisión). Off hasta MP 1:N.
FUNDING_ESCROW_FULL_ENABLED=false

# Email
# Switch: auto | smtp | resend | console
# - smtp: Nodemailer (Gmail u otro). Requiere SMTP_*
# - resend: API Resend. Requiere RESEND_API_KEY + MAIL_FROM con dominio verificado
# - auto: SMTP si hay SMTP_HOST; si no, Resend si hay API key; si no, consola
# IMPORTANTE: definí MAIL_FROM una sola vez. Con Resend NO uses @gmail.com.
EMAIL_PROVIDER=auto
RESEND_API_KEY=
# Resend (dominio verificado):
MAIL_FROM=ConfiApp <confiapp@jpc-dev.uy>

# SMTP / Gmail — solo si EMAIL_PROVIDER=smtp (no agregues otro MAIL_FROM)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Destinatario de alertas internas (KYC). Vacío = se usa el email de MAIL_FROM
PLATFORM_NOTIFY_EMAIL=

# Admin bootstrap: al arrancar la API crea/actualiza este usuario como ADMIN verificado.
# Dejá vacío para desactivar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=ConfiApp Admin

# Job interno: POST /transactions/jobs/expire-deadlines (header x-job-secret).
# Job interno: POST /transactions/jobs/auto-delivery (header x-job-secret).
# Vacío = permitido sin secret en development; requerido en production.
TRANSACTIONS_JOB_SECRET=

# Identidad Digital Abitab (authorization code + PIN).
# Registrar redirect exactamente igual en el panel Abitab.
# Prod Railway: https://confiappapi-production.up.railway.app/auth/id-digital/callback
ID_DIGITAL_CLIENT_ID=
ID_DIGITAL_CLIENT_SECRET=
ID_DIGITAL_REDIRECT_URI=http://localhost:3000/auth/id-digital/callback
ID_DIGITAL_AUTH_URL=https://login.identidaddigital.com.uy/v2/authorize
ID_DIGITAL_TOKEN_URL=https://auth.identificaciondigital.com.uy/api/v2/openid/token
ID_DIGITAL_ISSUER=https://auth.identificaciondigital.com.uy/api/v2/openid
ID_DIGITAL_SCOPE=openid profile
ID_DIGITAL_ACR_VALUES=pin
