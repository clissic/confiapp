# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (Mongoose / MongoDB)
# Opcional (solo referencia). La app usa DATABASE_URL.
MONGODB_USERNAME=
MONGODB_PASSWORD=
DATABASE_URL=mongodb://127.0.0.1:27017/confiapp?directConnection=true

# Auth / JWT (secrets >= 32 chars)
JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_REFRESH_EXPIRES_IN=7d

# Public URLs (email links)
APP_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000

# CORS (en desarrollo también se aceptan IPs LAN y túneles automáticamente)
CORS_ORIGIN=http://localhost:3001

# Cookies
COOKIE_SECURE=false

# Logging
LOG_LEVEL=debug

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Lockout (OWASP)
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ── Mercado Pago Uruguay (cuenta MLU / plataforma) ──────────────────────────
# Access Token de la aplicación en https://www.mercadopago.com.uy/developers
# Vacío = Checkout Pro en MOCK local. Con token = preferencias reales.
MERCADOPAGO_ACCESS_TOKEN=
# Secret de firmas del webhook (panel MP → Webhooks → Secret). Opcional en dev.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COUNTRY=UY
MERCADOPAGO_SITE_ID=MLU
# Refunds live vía API (false = no ejecuta refunds reales)
MERCADOPAGO_ENABLE_REFUNDS=false

# OAuth vendedores/agentes (Authorization Code). Independiente del ACCESS_TOKEN.
# En el panel MP → Tu aplicación → Credenciales: Application ID + Client Secret.
# Redirect URI debe coincidir EXACTAMENTE con la del panel (sin query extra).
# Local y prod usan URLs distintas: en local NO uses la de Railway.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Local: http://localhost:3000/payments/mercadopago/oauth/callback
# Prod Railway: https://confiappapi-production.up.railway.app/payments/mercadopago/oauth/callback
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3000/payments/mercadopago/oauth/callback
# Solo true si en el panel MP habilitaste "Authorization code flow with PKCE"
MERCADOPAGO_OAUTH_USE_PKCE=false
# AES-256 para cifrar tokens de sellers (64 hex). Generar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=

# Cobro al comprador: manual_prex | mercadopago
# mercadopago = Checkout Pro (o MOCK si ACCESS_TOKEN vacío)
PAYMENTS_CHECKOUT_MODE=mercadopago
PAYMENTS_PREX_ACCOUNT_NAME=Ignacio La Cava
PAYMENTS_PREX_ACCOUNT_NUMBER=1065233
PAYMENTS_DEFAULT_CURRENCY=UYU
PAYMENTS_PLATFORM_FEE_BPS=2000
PAYMENTS_AGENT_FEE_BPS=8000
USD_UYU_RATE=40
FUNDING_ESCROW_FULL_ENABLED=false

# Email
# Switch: auto | smtp | resend | console
EMAIL_PROVIDER=auto
RESEND_API_KEY=
# Remitente verificado en Resend (NO uses @gmail.com con Resend)
MAIL_FROM=ConfiApp <confiapp@jpc-dev.uy>
PLATFORM_NOTIFY_EMAIL=

# Gmail / SMTP (solo si EMAIL_PROVIDER=smtp). No pongas otro MAIL_FROM abajo o pisa el de Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Admin bootstrap (cuenta ADMIN verificada)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=ConfiApp Admin

# Job interno: POST /transactions/jobs/expire-deadlines (header x-job-secret).
# Recordatorio a comprador/agente tras 21 días sin completar (no cancela la op).
# Job interno: POST /transactions/jobs/auto-delivery (header x-job-secret).
# Vacío = permitido sin secret en development; requerido en production.
TRANSACTIONS_JOB_SECRET=

# Identidad Digital Abitab (authorization code + PIN).
# Registrar redirect exactamente igual en el panel Abitab.
# Prod Railway: https://confiappapi-production.up.railway.app/auth/id-digital/callback
ID_DIGITAL_CLIENT_ID=
ID_DIGITAL_CLIENT_SECRET=
ID_DIGITAL_REDIRECT_URI=http://localhost:3000/auth/id-digital/callback
ID_DIGITAL_AUTH_URL=https://login.identidaddigital.com.uy/v2/authorize
ID_DIGITAL_TOKEN_URL=https://auth.identificaciondigital.com.uy/api/v2/openid/token
ID_DIGITAL_ISSUER=https://auth.identificaciondigital.com.uy/api/v2/openid
ID_DIGITAL_SCOPE=openid profile
ID_DIGITAL_ACR_VALUES=pin
