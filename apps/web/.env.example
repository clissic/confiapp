VITE_API_URL=http://localhost:3000
VITE_APP_NAME=ConfiApp
VITE_APP_ENV=development

# CARTO Basemaps (raster) — quita el watermark "API key required"
# https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=

# Cloudflare Turnstile site key (público). Vacío = sin widget en local.
VITE_TURNSTILE_SITE_KEY=

# Sentry (monitoreo de errores). Vacío = Sentry desactivado.
# El DSN se define en el entorno de build (Railway), no se hardcodea.
VITE_SENTRY_DSN=
# Opcional: por defecto usa el modo de Vite (development/production).
VITE_SENTRY_ENVIRONMENT=
# Opcional: 0..1 (default 0 = sin tracing de performance).
VITE_SENTRY_TRACES_SAMPLE_RATE=
